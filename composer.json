{
    "name": "hardcastle/ledger-direct-core",
    "description": "LedgerDirect Core - platform-agnostic XRPL/commerce logic shared across all LedgerDirect plugins",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Alexander Busse",
            "homepage": "https://www.ledger-direct.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/log": "^3.0",
        "brick/math": "^0.12"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "Hardcastle\\LedgerDirect\\Core\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Hardcastle\\LedgerDirect\\Core\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
